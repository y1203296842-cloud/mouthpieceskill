{
  "version": "1.0",
  "about": "立场矩阵：对方做了什么（behavior）× 你们什么关系（relation）→ 你站在什么位置（position）+ 该怎么出手（next）。用来防止『别人踩你，你还替他找台阶』的自降低位。表为本项目自建中文场景表。",
  "positions": {
    "ABOVE": "你在上位：对方越界/贬低/使唤，不该自证、不该认前提、不该放低姿态",
    "AT": "平位：可接但可谈条件，话软事实不退，留证据不留把柄",
    "BELOW": "你理亏：唯一允许认错+给确定性的场景",
    "CUE": "线索位：对方话里有话或已设边界，只回应信号，不展开",
    "DEPENDS": "看情况：亲密关系/情绪场景，先判断要不要接情绪",
    "RARE": "少见位：对方身份不该这么说话，反常本身就是要接的点"
  },
  "next": {
    "DIRECT": "直接回，不软化、不加客套",
    "CHOOSE": "先给方向判断，再按场合选软或硬",
    "NO_REPLY": "根本不必回，或一个字带过；不要硬凑回怼"
  },
